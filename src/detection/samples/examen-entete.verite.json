    {
      "pageIndex": 0,
      "role": "q",
      "text": "On lance 100 fois une piece equilibree et on note N le nombre de piles.",
      "bbox": {
        "x": 72,
        "y": 111.35000000000002,
        "width": 345.57599999999996,
        "height": 10.45
      }
    },
    {
      "pageIndex": 0,
      "role": "q",
      "text": "(a) Donner la loi de N et son esperance.",
      "bbox": {
        "x": 72,
        "y": 128.95000000000005,
        "width": 194.755,
        "height": 10.45
      }
    },
    {
      "pageIndex": 0,
      "role": "c",
      "text": "Solution. N suit une loi binomiale de parametres 100 et 1/2.",
      "bbox": {
        "x": 72,
        "y": 146.55000000000007,
        "width": 287.815,
        "height": 10.45
      }
    },
    {
      "pageIndex": 0,
      "role": "c",
      "text": "Son esperance vaut 50.",
      "bbox": {
        "x": 72,
        "y": 164.1500000000001,
        "width": 115.797,
        "height": 10.45
      }
    },
    {
      "pageIndex": 0,
      "role": "q",
      "text": "(b) Calculer la variance de N.",
      "bbox": {
        "x": 72,
        "y": 181.7500000000001,
        "width": 142.31799999999998,
        "height": 10.45
      }
    },
    {
      "pageIndex": 0,
      "role": "c",
      "text": "Solution. La variance vaut 100 x 1/2 x 1/2 = 25.",
      "bbox": {
        "x": 72,
