    {
      "pageIndex": 0,
      "role": "q",
      "text": "1. Soit X une variable de loi uniforme sur [0, 1]. Calculer E(X).",
      "bbox": {
        "x": 72,
        "y": 96.95000000000005,
        "width": 298.474,
        "height": 10.45
      }
    },
    {
      "pageIndex": 0,
      "role": "c",
      "text": "Correction : par definition, E(X) est l integrale de x sur [0, 1].",
      "bbox": {
        "x": 72,
        "y": 114.55000000000007,
        "width": 291.467,
        "height": 10.45
      }
    },
    {
      "pageIndex": 0,
      "role": "c",
      "text": "On obtient E(X) = 1/2.",
      "bbox": {
        "x": 72,
        "y": 132.1500000000001,
        "width": 106.69999999999999,
        "height": 10.45
      }
    },
