        "width": 202,
        "height": 62
      }
    },
    {
      "pageIndex": 0,
      "role": "q",
      "text": "2. Calculer la variance de X.",
      "bbox": {
        "x": 72,
        "y": 217.7500000000001,
        "width": 136.785,
        "height": 10.45
      }
    },
    {
      "pageIndex": 0,
      "role": "c",
      "text": "Correction : V(X) = E(X²) - E(X)² = 1/3 - 1/4 = 1/12.",
